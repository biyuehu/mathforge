<Window x:Class="GaokaoMathTrainer.PracticeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="刷题" Height="760" Width="1000">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="ProgressText" Grid.Column="0" FontSize="16" VerticalAlignment="Center"/>
            <TextBlock x:Name="ScoreText" Grid.Column="1" FontSize="16" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            <TextBlock x:Name="HistoryText" Grid.Column="2" FontSize="13" Foreground="Gray" VerticalAlignment="Center" HorizontalAlignment="Right"/>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock x:Name="MetaText" FontSize="13" Foreground="Gray" Margin="0,0,0,8"/>
                <TextBlock x:Name="StemText" FontSize="18" TextWrapping="Wrap" Margin="0,0,0,16"/>

                <StackPanel x:Name="OptionsPanel" Margin="0,0,0,16"/>

                <Border x:Name="ResultPanel" Visibility="Collapsed" Background="#F5F5F5" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock x:Name="ResultText" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
                        <TextBlock Text="解析：" FontWeight="Bold" Margin="0,8,0,4"/>
                        <TextBlock x:Name="ExplanationText" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="PrevButton" Grid.Column="0" Content="上一题" Padding="16,8" Click="OnPrevClick" IsEnabled="False"/>
            <Button x:Name="SkipButton" Grid.Column="2" Content="跳过" Padding="16,8" Margin="0,0,8,0" Click="OnSkipClick"/>
            <Button x:Name="NextButton" Grid.Column="3" Content="下一题" Padding="16,8" Click="OnNextClick" IsEnabled="False"/>
        </Grid>
    </Grid>
</Window>