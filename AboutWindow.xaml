<Window x:Class="GaokaoMathTrainer.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="关于项目"
        Height="360"
        Width="480"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="24">
        <StackPanel>
            <TextBlock Text="高考数学刷题"
                    FontSize="22"
                    FontWeight="Bold"
                    Margin="0,0,0,8"/>
            <TextBlock x:Name="QuestionCountText"
                    FontSize="14"
                    Foreground="Gray"
                    Margin="0,0,0,16"/>

            <TextBlock Text="数据来源"
                    FontWeight="Bold"
                    Margin="0,0,0,4"/>
            <TextBlock Text="整理自 2015—2026 年高考数学题目，包含题干、选项、答案、解析、难度、知识板块与关键词等结构化字段。"
                       TextWrapping="Wrap"
                    Margin="0,0,0,16"/>

            <TextBlock Text="本地数据存储位置"
                    FontWeight="Bold"
                    Margin="0,0,0,4"/>
            <TextBlock x:Name="DataPathText"
                    TextWrapping="Wrap"
                    Foreground="Gray"
                    FontSize="12"
                    Margin="0,0,0,16"/>

            <TextBlock Text="技术栈：.NET 10 · WPF"
                    Foreground="Gray"
                    FontSize="12"/>
        </StackPanel>
    </Grid>
</Window>