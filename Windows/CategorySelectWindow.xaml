<Window x:Class="MathForge.CategorySelectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="分类刷题"
        Height="600"
        Width="900"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                Text="选择一个知识板块开始练习"
                FontSize="16"
                Margin="0,0,0,16"/>

        <ScrollViewer Grid.Row="1"
                VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="TopicList">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Click="OnTopicCardClick"
                                Tag="{Binding Name}"
                                Margin="8"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand">
                            <Border BorderBrush="#DDDDDD"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="16"
                                    Width="220"
                                    Background="White">
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}"
                                            FontSize="18"
                                            FontWeight="Bold"
                                            TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding TotalQuestions, StringFormat=共 {0} 题}"
                                            FontSize="14"
                                            Foreground="Gray"
                                            Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>