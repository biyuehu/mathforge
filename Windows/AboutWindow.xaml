<Window x:Class="MathForge.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="关于项目"
        Height="360"
        Width="480"
        WindowStartupLocation="CenterOwner">
        <Grid Margin="24">
                <StackPanel>
                        <TextBlock Text="高考数学刷题 - MathForge"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Margin="0,0,0,8"/>
                        <TextBlock x:Name="QuestionCountText"
                                   FontSize="14"
                                   Foreground="Gray"
                                   Margin="0,0,0,16"/>

                        <TextBlock Text="数据来源"
                                   FontWeight="Bold"
                                   Margin="0,0,0,4"/>
                        <TextBlock Text="整理自 2015—2026 年高考数学题目，包含题干、选项、答案、解析、难度、知识板块与关键词等结构化字段。"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,16"/>

                        <TextBlock Text="本地数据存储位置"
                                   FontWeight="Bold"
                                   Margin="0,0,0,4"/>
                        <TextBlock x:Name="DataPathText"
                                   TextWrapping="Wrap"
                                   Foreground="Gray"
                                   FontSize="12"
                                   Margin="0,0,0,16"/>

                        <TextBlock Text="项目简介"
                                   FontWeight="Bold"
                                   Margin="0,0,0,4"/>
                        <TextBlock Text="一个基于本地题库的高考数学刷题桌面应用，用 WPF (.NET) 构建，内置 LaTeX 公式渲染。"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,16"/>

                        <TextBlock Text="技术栈：.NET 10 · WPF"
                                   Foreground="Gray"
                                   FontSize="12"
                                   Margin="0,0,0,8"/>

                        <TextBlock Text="许可证：GPL-3.0-only"
                                   Foreground="Gray"
                                   FontSize="12"
                                   Margin="0,0,0,8"/>

                        <TextBlock>
                                <Hyperlink x:Name="ProjectLink"
                                           NavigateUri="https://github.com/biyuehu/mathforge"
                                           RequestNavigate="ProjectLink_RequestNavigate">
                                        <TextBlock Text="https://github.com/biyuehu/mathforge"
                                                   Foreground="DodgerBlue"
                                                   FontSize="12"/>
                                </Hyperlink>
                        </TextBlock>
                </StackPanel>
        </Grid>
</Window>