<Window x:Class="MathForge.AnalysisWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="数据分析"
    Height="780"
    Width="820"
        WindowStartupLocation="CenterOwner"
        Background="#FAFAFA">
  <Window.Resources>
    <local:RateToWidthConverter x:Key="RateToWidthConverter"
        xmlns:local="clr-namespace:MathForge"/>
  </Window.Resources>
  <ScrollViewer Margin="24"
      VerticalScrollBarVisibility="Auto">
    <StackPanel>

      <TextBlock Text="总览"
          FontSize="20"
          FontWeight="Bold"
          Margin="0,0,0,12"/>
      <Border Background="White"
          CornerRadius="10"
          Padding="20"
          Margin="0,0,0,28">
        <UniformGrid Columns="4"
            Rows="1">
          <StackPanel HorizontalAlignment="Center">
            <TextBlock x:Name="TotalCountText"
                FontSize="28"
                FontWeight="Bold"
                HorizontalAlignment="Center"/>
            <TextBlock Text="总作答次数"
                FontSize="12"
                Foreground="Gray"
                HorizontalAlignment="Center"
                Margin="0,4,0,0"/>
          </StackPanel>
          <StackPanel HorizontalAlignment="Center">
            <TextBlock x:Name="CorrectCountText"
                FontSize="28"
                FontWeight="Bold"
                Foreground="#2E9E44"
                HorizontalAlignment="Center"/>
            <TextBlock Text="正确"
                FontSize="12"
                Foreground="Gray"
                HorizontalAlignment="Center"
                Margin="0,4,0,0"/>
          </StackPanel>
          <StackPanel HorizontalAlignment="Center">
            <TextBlock x:Name="IncorrectCountText"
                FontSize="28"
                FontWeight="Bold"
                Foreground="#D9534F"
                HorizontalAlignment="Center"/>
            <TextBlock Text="错误"
                FontSize="12"
                Foreground="Gray"
                HorizontalAlignment="Center"
                Margin="0,4,0,0"/>
          </StackPanel>
          <StackPanel HorizontalAlignment="Center">
            <TextBlock x:Name="RateText"
                FontSize="28"
                FontWeight="Bold"
                Foreground="#4A90D9"
                HorizontalAlignment="Center"/>
            <TextBlock Text="正确率"
                FontSize="12"
                Foreground="Gray"
                HorizontalAlignment="Center"
                Margin="0,4,0,0"/>
          </StackPanel>
        </UniformGrid>
      </Border>

      <TextBlock Text="各知识板块正确率（按弱到强排序）"
          FontSize="20"
          FontWeight="Bold"
          Margin="0,0,0,12"/>
      <Border Background="White"
          CornerRadius="10"
          Padding="20"
          Margin="0,0,0,28">
        <ItemsControl x:Name="TopicMasteryList">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="140"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="60"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                    Text="{Binding Topic}"
                    VerticalAlignment="Center"
                    FontSize="14"/>
                <Border Grid.Column="1"
                    Background="#EEEEEE"
                    Height="16"
                    VerticalAlignment="Center"
                    CornerRadius="8"
                    Margin="8,0">
                  <Border HorizontalAlignment="Left"
                      Background="#4A90D9"
                      CornerRadius="8"
                          Width="{Binding CorrectRate, Converter={StaticResource RateToWidthConverter}}"/>
                </Border>
                <TextBlock Grid.Column="2"
                    Text="{Binding CorrectRate, StringFormat={}{0:F0}%}"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Right"
                    FontWeight="Bold"/>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Border>

      <TextBlock Text="错误归因分布"
          FontSize="20"
          FontWeight="Bold"
          Margin="0,0,0,12"/>
      <Border Background="White"
          CornerRadius="10"
          Padding="20"
          Margin="0,0,0,20">
        <StackPanel>
          <ItemsControl x:Name="ReasonList">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,0,0,14">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="50"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0"
                      Text="{Binding Reason}"
                      VerticalAlignment="Center"
                      FontSize="14"/>
                  <Border Grid.Column="1"
                      Background="#EEEEEE"
                      Height="16"
                      VerticalAlignment="Center"
                      CornerRadius="8"
                      Margin="8,0">
                    <Border HorizontalAlignment="Left"
                        Background="#E8964A"
                        CornerRadius="8"
                            Width="{Binding BarWidth}"/>
                  </Border>
                  <TextBlock Grid.Column="2"
                      Text="{Binding Count}"
                      VerticalAlignment="Center"
                      HorizontalAlignment="Right"
                      FontWeight="Bold"/>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock x:Name="NoReasonHint"
              Text="暂无错误归因数据"
              Foreground="Gray"
              FontSize="13"
              Visibility="Collapsed"/>
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</Window>