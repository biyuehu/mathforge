<Window x:Class="GaokaoMathTrainer.MistakeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="错题练习" Height="600" Width="700"
        WindowStartupLocation="CenterOwner">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
      <TextBlock Text="连续做对几次视为解决：" VerticalAlignment="Center"/>
      <ComboBox x:Name="ThresholdCombo" Width="80" Margin="8,0" SelectionChanged="OnThresholdChanged">
        <ComboBoxItem Content="1"/>
        <ComboBoxItem Content="2"/>
        <ComboBoxItem Content="3"/>
      </ComboBox>
      <TextBlock x:Name="MistakeCountText" VerticalAlignment="Center" Margin="16,0,0,0" Foreground="Gray"/>
    </StackPanel>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <ItemsControl x:Name="MistakeList">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,8">
              <StackPanel>
                <TextBlock Text="{Binding StemPreview}" TextWrapping="Wrap" FontSize="14"/>
                <TextBlock Text="{Binding StatusLabel}" Foreground="Gray" FontSize="12" Margin="0,4,0,0"/>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <Button Grid.Row="2" Content="开始错题练习" Padding="20,8" HorizontalAlignment="Right" Margin="0,16,0,0" Click="OnStartClick"/>
  </Grid>
</Window>