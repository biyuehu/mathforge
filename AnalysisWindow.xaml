<Window x:Class="GaokaoMathTrainer.AnalysisWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="数据分析" Height="720" Width="800"
        WindowStartupLocation="CenterOwner">
  <Window.Resources>
    <local:RateToWidthConverter x:Key="RateToWidthConverter" xmlns:local="clr-namespace:GaokaoMathTrainer"/>
  </Window.Resources>
  <ScrollViewer Margin="20" VerticalScrollBarVisibility="Auto">
    <StackPanel>
      <TextBlock Text="总览" FontSize="18" FontWeight="Bold" Margin="0,0,0,8"/>
      <TextBlock x:Name="OverviewText" FontSize="14" Margin="0,0,0,24"/>

      <TextBlock Text="各知识板块正确率（按弱到强排序）" FontSize="18" FontWeight="Bold" Margin="0,0,0,8"/>
      <ItemsControl x:Name="TopicMasteryList" Margin="0,0,0,24">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Grid Margin="0,0,0,10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="80"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="{Binding Topic}" VerticalAlignment="Center"/>
              <Border Grid.Column="1" Background="#EEEEEE" Height="18" VerticalAlignment="Center" CornerRadius="4">
                <Border HorizontalAlignment="Left" Background="#4A90D9" CornerRadius="4"
                        Width="{Binding CorrectRate, Converter={StaticResource RateToWidthConverter}}"/>
              </Border>
              <TextBlock Grid.Column="2" Text="{Binding CorrectRate, StringFormat={}{0:F0}%}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <TextBlock Text="错误归因分布" FontSize="18" FontWeight="Bold" Margin="0,0,0,8"/>
      <ItemsControl x:Name="ReasonList">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <TextBlock Margin="0,0,0,6">
              <Run Text="{Binding Reason}"/>
              <Run Text=" — "/>
              <Run Text="{Binding Count}"/>
              <Run Text=" 次"/>
            </TextBlock>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</Window>