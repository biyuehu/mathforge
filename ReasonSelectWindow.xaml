<Window x:Class="GaokaoMathTrainer.ReasonSelectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="错在哪了？" Height="420" Width="380"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" Text="可多选，也可以跳过不填" FontSize="13" Foreground="Gray" Margin="0,0,0,12"/>

    <StackPanel Grid.Row="1" x:Name="ReasonPanel"/>

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="跳过" Padding="16,6" Margin="0,0,8,0" Click="OnSkipClick"/>
      <Button Content="确定" Padding="16,6" Click="OnConfirmClick"/>
    </StackPanel>
  </Grid>
</Window>