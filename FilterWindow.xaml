<Window x:Class="GaokaoMathTrainer.FilterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="筛选刷题" Height="640" Width="720"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="知识板块（不勾选则不限）" FontWeight="Bold" Margin="0,0,0,8"/>
                <ItemsControl x:Name="TopicCheckList" Margin="0,0,0,16">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Content="{Binding Name}" Tag="{Binding Name}"
                                      Checked="OnFilterChanged" Unchecked="OnFilterChanged"
                                      Margin="0,0,16,8"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="题型（不勾选则不限）" FontWeight="Bold" Margin="0,0,0,8"/>
                <ItemsControl x:Name="TypeCheckList" Margin="0,0,0,16">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Content="{Binding}" Tag="{Binding}"
                                      Checked="OnFilterChanged" Unchecked="OnFilterChanged"
                                      Margin="0,0,16,8"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="难度（不勾选则不限）" FontWeight="Bold" Margin="0,0,0,8"/>
                <ItemsControl x:Name="DifficultyCheckList" Margin="0,0,0,16">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Content="{Binding}" Tag="{Binding}"
                                      Checked="OnFilterChanged" Unchecked="OnFilterChanged"
                                      Margin="0,0,16,8"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <CheckBox x:Name="OnlyUnattemptedCheck" Content="仅未做过的题"
                          Checked="OnFilterChanged" Unchecked="OnFilterChanged" Margin="0,0,0,16"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,12">
            <TextBlock Text="本次刷题数量：" VerticalAlignment="Center"/>
            <TextBox x:Name="CountInput" Width="80" Margin="8,0" TextChanged="OnCountInputChanged"/>
            <TextBlock x:Name="HitCountText" VerticalAlignment="Center" Foreground="Gray"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="开始刷题" Padding="20,8" Click="OnStartClick"/>
        </StackPanel>
    </Grid>
</Window>